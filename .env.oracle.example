# Generate .env.oracle and private password files with scripts/start-oracle.ps1
# or scripts/start-oracle.sh. Never copy a colleague's private configuration.
AEGIS_MASTER_KEY=CHANGE_ME_MASTER_KEY
AEGIS_BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN
AEGIS_PORT=3003
AEGIS_BIND_ADDRESS=127.0.0.1
AEGIS_PUBLIC_ORIGIN=http://localhost:3003
AEGIS_ORACLE_SECRET_DIR=./secrets/oracle
ORACLE_IMAGE=container-registry.oracle.com/database/free:23.26.3.0
MODEL_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
AEGIS_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
AEGIS_ALLOW_MOCK=false
