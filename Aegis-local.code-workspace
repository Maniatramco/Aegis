{
  "folders": [{ "path": "." }],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Aegis: Run updated local app",
        "type": "process",
        "command": "${workspaceFolder}/.venv/Scripts/python.exe",
        "args": ["-B", "${workspaceFolder}/scripts/windows-dev.py", "start", "--web-port", "3002", "--api-port", "8002", "--reuse-ollama", "--runtime-dir", "${workspaceFolder}/data/local-desktop"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": [],
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "Aegis: Stop updated local app",
        "type": "process",
        "command": "${workspaceFolder}/.venv/Scripts/python.exe",
        "args": ["-B", "${workspaceFolder}/scripts/windows-dev.py", "stop", "--runtime-dir", "${workspaceFolder}/data/local-desktop"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": []
      }
    ]
  }
}
