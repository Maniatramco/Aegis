# Generate .env.oracle and private password files with local/ags_scripts/start-oracle.ps1
# or local/ags_scripts/start-oracle.sh. Never copy a colleague's private configuration.
AEGIS_MASTER_KEY=CHANGE_ME_MASTER_KEY
AEGIS_BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN
AEGIS_PORT=3003
AEGIS_BIND_ADDRESS=127.0.0.1
AEGIS_PUBLIC_ORIGIN=http://localhost:3003
AEGIS_ORACLE_SECRET_DIR=./secrets/oracle
ORACLE_IMAGE=container-registry.oracle.com/database/free:23.26.3.0
ORACLE_APP_USER=AGS_OWNER
MODEL_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
AEGIS_MODEL=qwen3:4b
EMBEDDING_MODEL=nomic-embed-text
AEGIS_ALLOW_MOCK=false

# Stateful assistant; legacy is an explicit rollback switch.
AEGIS_AGENT_ENGINE=langgraph

# Local vision OCR for scanned PDF pages and visible DOCX raster images.
AEGIS_OCR_ENABLED=true
AEGIS_OCR_MODEL=qwen2.5vl:3b
AEGIS_OCR_TIMEOUT=1200
AEGIS_OCR_CONTEXT=8192
AEGIS_OCR_MAX_TOKENS=3000
AEGIS_OCR_DPI=180
AEGIS_OCR_BATCH=128
# False preserves automatic accessible GPU selection and CPU fallback.
AEGIS_OCR_FORCE_CPU=false
