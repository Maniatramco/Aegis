FROM python:3.12-slim
WORKDIR /app
COPY ags_backend/requirements.txt ags_backend/requirements-oracle.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-oracle.txt pytest==9.1.1
COPY ags_backend/ags_app ./ags_backend/ags_app
COPY ags_backend/ags_tests ./ags_backend/ags_tests
COPY ags_local_use/ags_scripts/setup_oracle.py ./ags_local_use/ags_scripts/
COPY ags_local_use/ags_scripts/oracle_check.py ags_local_use/ags_scripts/oracle_model_check.py ags_local_use/ags_scripts/reset_admin_password.py ./ags_local_use/ags_scripts/
COPY ags_local_use/.env.oracle.example ./ags_local_use/
ENV PYTHONPATH=/app/ags_backend PYTHONUNBUFFERED=1
CMD ["python", "ags_local_use/ags_scripts/oracle_check.py"]
