FROM python:3.12-slim
WORKDIR /app
COPY ags_backend/requirements.lock ags_backend/requirements-oracle.txt ./
RUN pip install --no-cache-dir -r requirements.lock -r requirements-oracle.txt pytest==9.1.1
COPY ags_backend/ags_app ./ags_backend/ags_app
COPY ags_backend/ags_tests ./ags_backend/ags_tests
COPY local/ags_scripts/setup_oracle.py ./local/ags_scripts/
COPY ags_scripts/oracle_check.py ags_scripts/oracle_model_check.py ags_scripts/reset_admin_password.py ags_scripts/migrate_storage.py ./ags_scripts/
COPY local/.env.oracle.example ./local/
ENV PYTHONPATH=/app/ags_backend PYTHONUNBUFFERED=1
CMD ["python", "ags_scripts/oracle_check.py"]
