# Run ./scripts/setup.sh once to generate private local secrets.
# Never commit .env. Back it up securely and separately from data backups.
AEGIS_MASTER_KEY=CHANGE_ME_MASTER_KEY
AEGIS_BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
AEGIS_PORT=3000
# Model calls use the key entered in the authenticated Settings screen.
MODEL_PROVIDER=openai
EMBEDDING_PROVIDER=sentence_transformers
SEARCH_PROVIDER=qdrant
# Production local default downloads the embedding model on first indexing.
INSTALL_LOCAL_EMBEDDINGS=true
# Test provider is deliberately disabled for ordinary use.
AEGIS_ALLOW_MOCK=false

# Optional native local-only Ollama setup (see docs/OLLAMA.md).
# MODEL_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# AEGIS_MODEL=qwen3:4b
# EMBEDDING_MODEL=nomic-embed-text
# SEARCH_PROVIDER=local
# AEGIS_LOCAL_ONLY=true
# AEGIS_TIMEOUT=180
# Launch Ollama with OLLAMA_NO_CLOUD=1 and OLLAMA_HOST=127.0.0.1:11434.

# Optional offline CPU cross-encoder; see docs/RERANKING.md for installation.
AEGIS_RERANKER=none
AEGIS_RERANK_CANDIDATES=25
# AEGIS_RERANK_MODEL_DIR=/absolute/path/to/local-models/ms-marco-MiniLM-L6-v2

# Optional OCI defaults. Non-secret destination fields are also editable in Settings.
# See docs/OCI_MIGRATION.md before enabling cloud storage/search/jobs.
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=
OCI_OBJECT_PREFIX=aegis
OCI_AUTH_MODE=config_file
OCI_PROFILE=DEFAULT
OCI_QUEUE_ID=
OCI_QUEUE_ENDPOINT=
